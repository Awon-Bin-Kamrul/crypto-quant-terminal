# Web terminal configuration (copy to .env.local). Only NEXT_PUBLIC_* values reach the browser,
# and none of them is a secret: the operator enters the API token at sign-in.

# The terminal gateway started by `cq api serve` (its CQ_API_CORS_ORIGINS must list this app).
NEXT_PUBLIC_CQ_API_URL=http://127.0.0.1:8000
# Stream transport: auto (WebSocket, falling back to Server-Sent Events), ws or sse.
NEXT_PUBLIC_CQ_STREAM_TRANSPORT=auto
