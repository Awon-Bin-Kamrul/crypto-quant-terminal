# ==========================================================================================
# Crypto Quant Terminal — environment contract
#
# One file feeds both docker-compose (variable interpolation) and the backend
# (pydantic-settings, prefix CQ_). Copy to .env, or run `make env` to copy it and fill every
# <generate> placeholder with a random secret. .env is git-ignored; never commit it.
# ==========================================================================================

# ------------------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------------------
CQ_ENV=development                 # development | test | production
CQ_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
CQ_LOG_JSON=false                  # true in production: one JSON object per line
CQ_METRICS_PORT=9108               # Prometheus /metrics for long-running processes; 0 = off
# Code version written into backtest manifests. Leave unset in a git checkout (`git describe`
# is used); image builds set it, because the .git directory is not shipped.
# CQ_CODE_VERSION=v0.2.0+abc123

# ------------------------------------------------------------------------------------------
# Trading safety (docs/ARCHITECTURE.md D10). Live trading needs BOTH switches below.
# ------------------------------------------------------------------------------------------
CQ_TRADING_MODE=paper              # paper | sandbox | live — highest mode this deployment runs
CQ_LIVE_TRADING_ENABLED=false      # second key; must be true for mode=live to start
CQ_MAX_ORDER_NOTIONAL_USD=1000     # hard cap per order, enforced outside strategy code
CQ_MAX_GROSS_EXPOSURE_USD=10000    # hard cap across all open positions of a session
CQ_TRADE_METRICS_PORT=9109         # Prometheus /metrics of `cq trade run`; 0 = off
# Paper venue fill model (cq trade run --mode paper): fees and slippage without a fresh book.
CQ_PAPER_MAKER_BPS=2
CQ_PAPER_TAKER_BPS=5
CQ_PAPER_SLIPPAGE_BPS=5

# ------------------------------------------------------------------------------------------
# Exchange (CCXT). Use keys WITHOUT withdrawal permission. Sandbox/testnet first.
# ------------------------------------------------------------------------------------------
CQ_EXCHANGE_ID=binance             # any CCXT exchange id
CQ_EXCHANGE_MARKET_TYPE=spot       # spot | swap
CQ_EXCHANGE_SANDBOX=true
CQ_EXCHANGE_API_KEY=
CQ_EXCHANGE_API_SECRET=

# ------------------------------------------------------------------------------------------
# Market data ingestion (cq ingest ...). Public data needs no API keys and never uses them.
# ------------------------------------------------------------------------------------------
CQ_INGEST_SYMBOLS=BTC/USDT,ETH/USDT    # CCXT unified symbols, comma-separated
CQ_INGEST_USE_SANDBOX=false        # sandbox prices are synthetic; keep false for research
CQ_INGEST_BOOK_DEPTH=25            # order book levels per side published to Redis
CQ_INGEST_BOOK_PUBLISH_HZ=10       # conflated order book snapshots per second per symbol
CQ_INGEST_STARTUP_LOOKBACK_DAYS=7  # gap-fill window checked every time the ingestor starts
CQ_INGEST_RECONCILE_INTERVAL_S=300 # how often the recent window is re-verified against REST
CQ_INGEST_RECONCILE_WINDOW_MIN=120
CQ_INGEST_STALE_BARS_S=30          # silence after which a bar stream counts as stale
CQ_INGEST_STALE_BOOK_S=60
CQ_INGEST_HEARTBEAT_S=5
CQ_INGEST_MAX_CONCURRENT_BACKFILLS=2
# Empty = use the largest page the venue serves, as reported by CCXT.
CQ_INGEST_REST_PAGE_LIMIT=

# ------------------------------------------------------------------------------------------
# TimescaleDB
#   owner role  — owns schemas, runs `cq db migrate` (superuser inside the container)
#   app role    — used by every running service; DML only
# ------------------------------------------------------------------------------------------
CQ_DB_HOST=127.0.0.1
CQ_DB_PORT=5432
CQ_DB_NAME=cq
CQ_DB_TEST_NAME=cq_test
CQ_DB_OWNER_USER=cq_owner
CQ_DB_OWNER_PASSWORD=<generate>
CQ_DB_APP_USER=cq_app
CQ_DB_APP_PASSWORD=<generate>
CQ_DB_POOL_MIN_SIZE=2
CQ_DB_POOL_MAX_SIZE=20
CQ_DB_TUNE_MEMORY=4GB              # memory timescaledb-tune sizes buffers for (first boot)
CQ_DB_TUNE_CPUS=4

# ------------------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------------------
CQ_REDIS_HOST=127.0.0.1
CQ_REDIS_PORT=6379
CQ_REDIS_PASSWORD=<generate>
CQ_REDIS_DB=0
CQ_REDIS_TEST_DB=15

# ------------------------------------------------------------------------------------------
# Terminal gateway (cq api serve) and web terminal (frontend/, Module 4)
# ------------------------------------------------------------------------------------------
CQ_API_HOST=127.0.0.1
CQ_API_PORT=8000
CQ_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   # origins of the web terminal
CQ_API_TOKEN=<generate>            # bearer token for the single-operator deployment
CQ_API_TICKET_TTL_S=30             # lifetime of single-use stream tickets
CQ_API_HEARTBEAT_S=15              # idle streams get a heartbeat this often
CQ_API_MAX_CONNECTIONS=200         # concurrent WebSocket + SSE streams per process
CQ_API_DOCS=true                   # OpenAPI docs at /api/docs
# The web terminal reads its own variables (frontend/.env.local, see frontend/.env.example):
# NEXT_PUBLIC_CQ_API_URL=http://127.0.0.1:8000
